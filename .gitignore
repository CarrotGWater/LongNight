# ---- 编辑器 / IDE ----
.idea/
*.iml
.vscode/
*.swp
*.swo
*~

# ---- 操作系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 构建输出 / 缓存 ----
bin/
obj/
*.pyc
__pycache__/

# ---- Wiki 文档（独立维护，不上传仓库） ----
wiki/
